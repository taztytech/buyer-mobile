{
  "expo": {
    "name": "Tazty",
    "slug": "Tazty",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valarcom.tazty"
    },
    "android": {
      "package": "com.valarcom.tazty"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
