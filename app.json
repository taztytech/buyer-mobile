{
  "expo": {
    "name": "Tazty",
    "slug": "Tazty",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "hitasoft",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.tazty.buyer",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "This app uses notifications to keep you updated on your orders and special offers."
      }
    },
    "android": {
      "package": "in.tazty.buyer",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "7d65a380-eee0-49b0-9f39-a5cd6eaede5a"
      }
    }
  }
}
