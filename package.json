{
  "name": "tazty",
  "version": "1.0.7",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env ENV_FILE=.env.dev expo start",
    "start:prod": "cross-env ENV_FILE=.env.prod expo start",
    "android": "expo run:android",
    "android:clean": "cd android && rm -rf app/.cxx app/build build && cd ..",
    "android:dev": "cross-env ENV_FILE=.env.dev npx expo run:android --variant devDebug",
    "android:prod": "cross-env ENV_FILE=.env.prod expo run:android --variant prodDebug",
    "ios": "expo run:ios",
    "ios:dev": "cross-env ENV_FILE=.env.dev expo run:ios",
    "ios:prod": "cross-env ENV_FILE=.env.prod expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.js patch",
    "version:bump:patch": "node scripts/bump-version.js patch",
    "version:bump:minor": "node scripts/bump-version.js minor",
    "version:bump:major": "node scripts/bump-version.js major",
    "version:bump:android": "node scripts/bump-android-version.js patch",
    "version:bump:ios": "node scripts/bump-ios-version.js patch",
    "version:increment": "node scripts/increment-version.js patch",
    "version:increment:patch": "node scripts/increment-version.js patch",
    "version:increment:minor": "node scripts/increment-version.js minor",
    "version:increment:major": "node scripts/increment-version.js major",
    "verify:release": "node scripts/verify-release-readiness.js",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:android:all:release:dev": "cross-env ENV_FILE=.env.dev node scripts/build-android.js dev apk all",
    "build:android:all:release:prod": "cross-env ENV_FILE=.env.prod node scripts/build-android.js prod apk all",
    "build:android:all:bundle:dev": "cross-env ENV_FILE=.env.dev node scripts/build-android.js dev bundle all",
    "build:android:all:bundle:prod": "cross-env ENV_FILE=.env.prod node scripts/build-android.js prod bundle all",
    "release:android": "npm run version:bump:patch && npm run build:android:all:bundle:prod",
    "release:ios": "npm run version:bump:patch && npm run build:ios"
  },
  "dependencies": {
    "@expo-google-fonts/alfa-slab-one": "^0.4.1",
    "@expo-google-fonts/anek-tamil": "^0.4.1",
    "@expo-google-fonts/arima": "^0.4.2",
    "@expo-google-fonts/baloo-thambi-2": "^0.4.2",
    "@expo-google-fonts/bowlby-one-sc": "^0.4.1",
    "@expo-google-fonts/bungee": "^0.4.1",
    "@expo-google-fonts/catamaran": "^0.4.1",
    "@expo-google-fonts/chewy": "^0.4.0",
    "@expo-google-fonts/coiny": "^0.4.1",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/hind-madurai": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/kalam": "^0.4.1",
    "@expo-google-fonts/kavivanar": "^0.4.1",
    "@expo-google-fonts/lobster": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/mukta-malar": "^0.4.1",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo-google-fonts/oi": "^0.4.1",
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo-google-fonts/passion-one": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/righteous": "^0.4.1",
    "@expo-google-fonts/rubik-bubbles": "^0.4.0",
    "@expo-google-fonts/titan-one": "^0.4.1",
    "@expo-google-fonts/ultra": "^0.4.0",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/analytics": "^23.4.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/crashlytics": "^23.4.0",
    "@react-native-firebase/messaging": "^23.4.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dotenv": "^17.2.3",
    "eas-cli": "^16.23.1",
    "expo": "~54.0.25",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.9",
    "expo-font": "^14.0.9",
    "expo-image": "^3.0.11",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.13",
