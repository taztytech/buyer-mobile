    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-clarity": "^4.8.0",
    "react-native-device-info": "^15.0.1",
    "react-native-maps": "^1.27.1",
    "react-native-pip-android": "^1.0.1",
    "react-native-razorpay": "^2.3.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-svg": "15.12.1",
    "react-native-webview": "^13.15.0",
    "sp-react-native-in-app-updates": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native-razorpay": "^2.2.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^54.0.4",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "volta": {
    "node": "22.20.0"
  }
}
