{
  "name": "tazty",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:android:all:release:dev": "node scripts/build-android.js dev apk all",
    "build:android:all:release:prod": "node scripts/build-android.js prod apk all",
    "build:android:all:bundle:dev": "node scripts/build-android.js dev bundle all",
    "build:android:all:bundle:prod": "node scripts/build-android.js prod bundle all"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "dotenv": "^17.2.3",
    "eas-cli": "^16.23.1",
    "expo": "~54.0.25",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.9",
    "expo-font": "^14.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.13",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-razorpay": "^2.3.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native-razorpay": "^2.2.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "volta": {
    "node": "22.20.0"
  }
}
