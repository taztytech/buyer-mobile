{
  "name": "tazty",
  "version": "1.0.4",
  "main": "index.ts",
  "scripts": {
    "start": "react-native start",
    "start:dev": "cross-env ENV_FILE=.env.dev react-native start",
    "start:prod": "cross-env ENV_FILE=.env.prod react-native start",
    "android": "react-native run-android",
    "android:clean": "cd android && rm -rf app/.cxx app/build build && cd ..",
    "android:dev": "cross-env ENV_FILE=.env.dev react-native run-android --mode devDebug",
    "android:prod": "cross-env ENV_FILE=.env.prod react-native run-android --mode prodDebug",
    "ios": "react-native run-ios",
    "ios:dev": "cross-env ENV_FILE=.env.dev react-native run-ios",
    "ios:prod": "cross-env ENV_FILE=.env.prod react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.js patch",
    "version:bump:patch": "node scripts/bump-version.js patch",
    "version:bump:minor": "node scripts/bump-version.js minor",
    "version:bump:major": "node scripts/bump-version.js major",
    "version:bump:android": "node scripts/bump-android-version.js patch",
    "version:bump:ios": "node scripts/bump-ios-version.js patch",
    "version:increment": "node scripts/increment-version.js patch",
    "version:increment:patch": "node scripts/increment-version.js patch",
    "version:increment:minor": "node scripts/increment-version.js minor",
    "version:increment:major": "node scripts/increment-version.js major",
    "verify:release": "node scripts/verify-release-readiness.js",
    "build:ios": "xcodebuild -workspace ios/Tazty.xcworkspace -scheme Tazty -configuration Release -sdk iphoneos -derivedDataPath ios/build",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:all:release:dev": "cross-env ENV_FILE=.env.dev node scripts/build-android.js dev apk all",
    "build:android:all:release:prod": "cross-env ENV_FILE=.env.prod node scripts/build-android.js prod apk all",
    "build:android:all:bundle:dev": "cross-env ENV_FILE=.env.dev node scripts/build-android.js dev bundle all",
    "build:android:all:bundle:prod": "cross-env ENV_FILE=.env.prod node scripts/build-android.js prod bundle all",
    "release:android": "npm run version:bump:patch && npm run build:android:all:bundle:prod",
    "release:ios": "npm run version:bump:patch && npm run build:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/analytics": "^23.4.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/crashlytics": "^23.4.0",
    "@react-native-firebase/messaging": "^23.4.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dotenv": "^17.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.1",
    "react-native-geocoding": "^0.5.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.27.1",
    "react-native-pip-android": "^1.0.1",
    "react-native-razorpay": "^2.3.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.10.0",
    "react-native-webview": "^13.15.0",
    "sp-react-native-in-app-updates": "^1.5.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/babel-preset": "^0.81.5",
    "@react-native/metro-config": "^0.85.0",
    "@react-native/typescript-config": "^0.81.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "@types/react-native-razorpay": "^2.2.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "volta": {
    "node": "22.20.0"
  }
}
